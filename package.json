{
  "name": "chuspanumeric",
  "version": "1.0.0",
  "description": "Numerical methods library for mathematics and engineering applications",
  "main": "dist/chuspanumeric.cjs.js",
  "module": "dist/chuspanumeric.esm.js",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "chuspanumeric": "./src/cli/chuspanumeric-cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/chuspanumeric.cjs.js",
      "import": "./dist/chuspanumeric.esm.js"
    }
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "rollup -c",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=\"{\\\"testMatch\\\":[\\\"**/*.test.js\\\"],\\\"passWithNoTests\\\":true}\"",
    "test:watch": "jest --watch tests",
    "test:cov": "jest --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write src/**/*.js tests/**/*.js",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "check:circular": "madge --circular --extensions js src/",
    "prepare": "husky"
  },
  "keywords": [
    "numerical-methods",
    "mathematics",
    "engineering"
  ],
  "homepage": "https://github.com/sis-inf/chuspanumeric#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sis-inf/chuspanumeric.git"
  },
  "bugs": {
    "url": "https://github.com/sis-inf/chuspanumeric/issues"
  },
  "author": "sis-inf",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.68.0"
  },
  "dependencies": {
    "mathjs": "^15.2.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
